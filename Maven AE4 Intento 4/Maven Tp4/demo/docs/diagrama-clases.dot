digraph G {
  rankdir=BT; compound=true; nodesep=0.35; ranksep=0.7; splines=true;
  node [shape=plain, fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=9, arrowsize=0.8];
  labelloc=t; fontname="Helvetica-Bold"; fontsize=18; label="Sistema de facturación — Diagrama de clases AE4 (capas y patrones)";
  subgraph cluster_pres { label=<<B>CAPA DE PRESENTACIÓN  (paquete presentacion)</B>>; style="rounded,filled"; fillcolor="#F4F4F8"; color="#777777"; fontname="Helvetica"; fontsize=13;
  Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Main</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+main(args)  // solo inicia<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Aplicacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Aplicacion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">raíz de composición<BR ALIGN="LEFT"/>+iniciar()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Menu [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Menu</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-opciones: List&lt;Opcion&gt;<BR ALIGN="LEFT"/>+iniciar()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Pantalla [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Pantalla</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+mostrarFactura(f)<BR ALIGN="LEFT"/>+listarClientes(l)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Demo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Demo</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+main(args)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_serv { label=<<B>CAPA DE SERVICIO  (paquete servicio)</B>>; style="rounded,filled"; fillcolor="#F4F8F4"; color="#777777"; fontname="Helvetica"; fontsize=13;
  ServicioClientes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>ServicioClientes</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+registrar(...)<BR ALIGN="LEFT"/>+porCompras() / porLimite()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  ServicioFacturacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>ServicioFacturacion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+emitir(...)<BR ALIGN="LEFT"/>+registrarPago(f, importe)<BR ALIGN="LEFT"/>+porMonto() / porFecha()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  ServicioPersistencia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>ServicioPersistencia</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+guardarTodo()<BR ALIGN="LEFT"/>+recuperarTodo()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  CargaInicial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>CargaInicial</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+cargar(empresa)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_dom { label=<<B>CAPA DE DOMINIO  (paquetes dominio.*)</B>>; style="rounded,filled"; fillcolor="#FBF7EC"; color="#777777"; fontname="Helvetica"; fontsize=13;
  Valorizable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Valorizable</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+obtenerValor()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Persona [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B><I>Persona</I></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-nombre, domicilio, dni, telefono<BR ALIGN="LEFT"/>+getRol()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Cliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Cliente</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-limiteCredito, saldoPendiente<BR ALIGN="LEFT"/>+registrarCompra()<BR ALIGN="LEFT"/>+restaurarEstado()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Empleado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Empleado</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-salario, puesto<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Proveedor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Proveedor</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-razonSocial, nif<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Departamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Departamento</B></TD></TR></TABLE>>];
  CategoriaCliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«enum»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>CategoriaCliente</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">REGULAR, PREMIUM, CORPORATIVO<BR ALIGN="LEFT"/>+getEstrategiaDescuento()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  OfertaComercial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B><I>OfertaComercial</I></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-codigo, nombre, precio<BR ALIGN="LEFT"/>+calcularPrecioFinal()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Producto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Producto</B></TD></TR></TABLE>>];
  Servicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Servicio</B></TD></TR></TABLE>>];
  EstrategiaDescuento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>EstrategiaDescuento</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#CFE3FF"><FONT POINT-SIZE="9" COLOR="#222222">STRATEGY · Estrategia</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+calcularDescuento(subtotal)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  DescuentoRegular [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>DescuentoRegular</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#CFE3FF"><FONT POINT-SIZE="9" COLOR="#222222">STRATEGY · Estrategia concreta</FONT></TD></TR></TABLE>>];
  DescuentoPremium [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>DescuentoPremium</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#CFE3FF"><FONT POINT-SIZE="9" COLOR="#222222">STRATEGY · Estrategia concreta</FONT></TD></TR></TABLE>>];
  DescuentoCorporativo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>DescuentoCorporativo</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#CFE3FF"><FONT POINT-SIZE="9" COLOR="#222222">STRATEGY · Estrategia concreta</FONT></TD></TR></TABLE>>];
  Factura [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Factura</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#CFE3FF"><FONT POINT-SIZE="9" COLOR="#222222">STRATEGY · Contexto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+emitir()<BR ALIGN="LEFT"/>+registrarPago(importe)<BR ALIGN="LEFT"/>+calcularTotal()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B><I>Pago</I></B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#D3F2D0"><FONT POINT-SIZE="9" COLOR="#222222">FACTORY METHOD · Producto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-numero, fecha, monto<BR ALIGN="LEFT"/>+calcularRecargo(base)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  PagoEfectivo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>PagoEfectivo</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#D3F2D0"><FONT POINT-SIZE="9" COLOR="#222222">FACTORY METHOD · Producto concreto</FONT></TD></TR></TABLE>>];
  PagoTarjeta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>PagoTarjeta</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#D3F2D0"><FONT POINT-SIZE="9" COLOR="#222222">FACTORY METHOD · Producto concreto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">recargo 5%<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  PagoTransferencia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>PagoTransferencia</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#D3F2D0"><FONT POINT-SIZE="9" COLOR="#222222">FACTORY METHOD · Producto concreto</FONT></TD></TR></TABLE>>];
  FabricaPago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FabricaPago</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#D3F2D0"><FONT POINT-SIZE="9" COLOR="#222222">FACTORY METHOD · Creador</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+crearPago(numero, fecha, monto)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  FabricaPagoEfectivo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>FabricaPagoEfectivo</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#D3F2D0"><FONT POINT-SIZE="9" COLOR="#222222">FACTORY METHOD · Creador concreto</FONT></TD></TR></TABLE>>];
  FabricaPagoTarjeta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>FabricaPagoTarjeta</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#D3F2D0"><FONT POINT-SIZE="9" COLOR="#222222">FACTORY METHOD · Creador concreto</FONT></TD></TR></TABLE>>];
  FabricaPagoTransferencia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>FabricaPagoTransferencia</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#D3F2D0"><FONT POINT-SIZE="9" COLOR="#222222">FACTORY METHOD · Creador concreto</FONT></TD></TR></TABLE>>];
  FormasDePago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>FormasDePago</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">registro texto → FabricaPago<BR ALIGN="LEFT"/>+fabricaPara(texto)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  EstadoPago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«enum»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>EstadoPago</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PENDIENTE, PARCIAL, COMPLETO<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Empresa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Empresa</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">-clientes, empleados, catalogo, facturas<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Excepciones [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Excepciones de dominio</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DatoInvalidoException<BR ALIGN="LEFT"/>FacturaSinItemsException<BR ALIGN="LEFT"/>LimiteCreditoExcedidoException<BR ALIGN="LEFT"/>PagoExcedidoException<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_per { label=<<B>CAPA DE PERSISTENCIA  (paquete persistencia)</B>>; style="rounded,filled"; fillcolor="#FBF0F0"; color="#777777"; fontname="Helvetica"; fontsize=13;
  Repositorio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Repositorio&lt;T&gt;</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#FFE2B8"><FONT POINT-SIZE="9" COLOR="#222222">ADAPTER · Objetivo (Target)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+guardar(List)<BR ALIGN="LEFT"/>+cargar(): List&lt;T&gt;<BR ALIGN="LEFT"/>+leerRegistros()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  RepoClientes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>RepositorioClientesArchivo</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#FFE2B8"><FONT POINT-SIZE="9" COLOR="#222222">ADAPTER · Adaptador</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Cliente ⇄ línea de texto<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  RepoFacturas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>RepositorioFacturasArchivo</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#FFE2B8"><FONT POINT-SIZE="9" COLOR="#222222">ADAPTER · Adaptador</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">Factura ⇄ línea de texto<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  GestorArchivo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>GestorArchivo</B></TD></TR><TR><TD ALIGN="CENTER" BGCOLOR="#FFE2B8"><FONT POINT-SIZE="9" COLOR="#222222">ADAPTER · Adaptado (Adaptee)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">~escribir(lineas)<BR ALIGN="LEFT"/>~leer()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  PersExc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>PersistenciaException</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DatosInexistentesException<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_leg { label=<<B>Referencias</B>>; style="rounded,filled"; fillcolor="#FFFFFF"; color="#777777"; fontname="Helvetica"; fontsize=13;
  leyenda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#CFE3FF">Strategy (comportamiento)</TD></TR><TR><TD BGCOLOR="#D3F2D0">Factory Method (creación)</TD></TR><TR><TD BGCOLOR="#FFE2B8">Adapter (estructural)</TD></TR><TR><TD>flecha punteada con triángulo = implementa</TD></TR><TR><TD>flecha con triángulo = hereda</TD></TR></TABLE>>];
  }
  Cliente -> Persona [arrowhead=empty];
  Empleado -> Persona [arrowhead=empty];
  Proveedor -> Persona [arrowhead=empty];
  Producto -> OfertaComercial [arrowhead=empty];
  Servicio -> OfertaComercial [arrowhead=empty];
  PagoEfectivo -> Pago [arrowhead=empty];
  PagoTarjeta -> Pago [arrowhead=empty];
  PagoTransferencia -> Pago [arrowhead=empty];
  DescuentoRegular -> EstrategiaDescuento [arrowhead=empty, style=dashed];
  DescuentoPremium -> EstrategiaDescuento [arrowhead=empty, style=dashed];
  DescuentoCorporativo -> EstrategiaDescuento [arrowhead=empty, style=dashed];
  FabricaPagoEfectivo -> FabricaPago [arrowhead=empty, style=dashed];
  FabricaPagoTarjeta -> FabricaPago [arrowhead=empty, style=dashed];
  FabricaPagoTransferencia -> FabricaPago [arrowhead=empty, style=dashed];
  RepoClientes -> Repositorio [arrowhead=empty, style=dashed];
  RepoFacturas -> Repositorio [arrowhead=empty, style=dashed];
  Empleado -> Valorizable [arrowhead=empty, style=dashed];
  OfertaComercial -> Valorizable [arrowhead=empty, style=dashed];
  Factura -> Valorizable [arrowhead=empty, style=dashed];
  Factura -> Cliente [];
  Factura -> Empleado [];
  Factura -> OfertaComercial [label="1..*"];
  Factura -> Pago [label="1"];
  Cliente -> CategoriaCliente [];
  CategoriaCliente -> EstrategiaDescuento [label="usa"];
  Pago -> EstadoPago [];
  Empleado -> Departamento [];
  OfertaComercial -> Proveedor [label="0..1"];
  FabricaPagoEfectivo -> PagoEfectivo [style=dashed, label="«create»"];
  FabricaPagoTarjeta -> PagoTarjeta [style=dashed, label="«create»"];
  FabricaPagoTransferencia -> PagoTransferencia [style=dashed, label="«create»"];
  FormasDePago -> FabricaPago [label="0..*"];
  Empresa -> Cliente [dir=both, arrowtail=odiamond, arrowhead=vee];
  Empresa -> Factura [dir=both, arrowtail=odiamond, arrowhead=vee];
  ServicioClientes -> Empresa [];
  ServicioFacturacion -> Empresa [];
  ServicioPersistencia -> Empresa [];
  ServicioFacturacion -> FormasDePago [label="inyectada"];
  ServicioFacturacion -> Factura [style=dashed, label="«create»"];
  ServicioPersistencia -> Repositorio [label="2 repos"];
  RepoClientes -> GestorArchivo [];
  RepoFacturas -> GestorArchivo [];
  RepoFacturas -> Empresa [style=dashed, label="busca"];
  RepoFacturas -> FormasDePago [style=dashed, label="recrea Pago"];
  Main -> Aplicacion [];
  Aplicacion -> Menu [style=dashed, label="«create»"];
  Menu -> ServicioClientes [];
  Menu -> ServicioFacturacion [];
  Menu -> ServicioPersistencia [];
  Menu -> Pantalla [];
  Demo -> Aplicacion [];
  Aplicacion -> RepoClientes [style=dashed, label="«create»"];
  Aplicacion -> RepoFacturas [style=dashed, label="«create»"];
  Aplicacion -> CargaInicial [style=dashed];
}
